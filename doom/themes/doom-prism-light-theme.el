;;; doom-prism-light-theme.el --- Prism Light -*- no-byte-compile: t; -*-
;;; Commentary:
;;; Generated by ~/System/dotfiles/themes/doom-theme from prism-light.conf
;;; (same palette as alacritty / dwm / firefox / vscode).
;;; Code:
(require 'doom-themes)

(def-doom-theme doom-prism-light
    "Prism Light."

  ;; name        default   256       16
  ((bg         '("#f6f2f7" nil       nil           ))
   (bg-alt     '("#efe9f0" nil       nil           ))
   (base0      '("#efe9f0" "black"   "black"       ))
   (base1      '("#e7e0e9" nil       nil           ))
   (base2      '("#e6d6e1" nil       nil           ))
   (base3      '("#e4cdd9" nil       nil           ))
   (base4      '("#b5aeb7" nil       nil           ))
   (base5      '("#8b838d" nil       nil           ))
   (base6      '("#716474" nil       nil           ))
   (base7      '("#6a5f6c" nil       nil           ))
   (base8      '("#1c151e" "white"   "white"       ))
   (fg         '("#302831" "white"   "white"       ))
   (fg-alt     '("#008388" "white"   "white"       ))

   (grey       base5)
   (red        '("#9c4343" "red"     "red"         ))
   (orange     '("#805632" "brightred" "brightred"   ))
   (green      '("#00765f" "green"   "green"       ))
   (teal       '("#008c93" "brightgreen" "brightgreen" ))
   (yellow     '("#925100" "yellow"  "yellow"      ))
   (blue       '("#6273c7" "brightblue" "brightblue"  ))
   (dark-blue  '("#4958b7" "blue"    "blue"        ))
   (magenta    '("#a23461" "magenta" "magenta"     ))
   (violet     '("#874197" "brightmagenta" "brightmagenta"))
   (cyan       '("#007378" "brightcyan" "brightcyan"  ))
   (dark-cyan  '("#3e9398" "cyan"    "cyan"        ))

   ;; syntax + chrome, straight from the .conf
   (t-keyword  '("#814e66" nil       nil           ))
   (t-function '("#5c5a89" nil       nil           ))
   (t-string   '("#206e66" nil       nil           ))
   (t-type     '("#73527b" nil       nil           ))
   (t-number   '("#805632" nil       nil           ))
   (t-accent   '("#8b4a70" nil       nil           ))
   (t-accent-fg '("#faf5f8" nil       nil           ))

   ;; accents for document structure (headings, links, quotes, tags)
   (coral      '("#814e66" "red"     "red"         ))
   (gold       '("#805632" "yellow"  "yellow"      ))
   (sage       '("#206e66" "green"   "green"       ))
   (peach      '("#805632" "brightred" "brightred"   ))
   (aqua       '("#5c5a89" "cyan"    "cyan"        ))
   (rose       '("#9c5eaa" "magenta" "magenta"     ))

   ;; face categories -- required for all themes
   (highlight      t-accent)
   (vertical-bar   base4)
   (selection      base3)
   (builtin        violet)
   (comments       base5)
   (doc-comments   base6)
   (constants      t-number)
   (functions      t-function)
   (keywords       t-keyword)
   (methods        t-function)
   (operators      base7)
   (type           t-type)
   (strings        t-string)
   (variables      fg)
   (numbers        t-number)
   (region         base3)
   (error          red)
   (warning        orange)
   (success        green)
   (vc-modified    violet)
   (vc-added       green)
   (vc-deleted     red)

   (modeline-fg     t-accent-fg)
   (modeline-bg     t-accent)
   (modeline-bg-inactive base1))

  ;; --- extra faces ------------------------
  (((line-number &override) :foreground base4)
   ((line-number-current-line &override) :foreground fg :weight 'bold)
   ((font-lock-keyword-face &override) :weight 'bold)
   ((font-lock-function-name-face &override) :weight 'bold)
   (cursor :background fg)
   ;; inverted mode-line, like the selected tag in the dwm bar
   (mode-line :background modeline-bg :foreground modeline-fg)
   (mode-line-inactive :background modeline-bg-inactive :foreground base6)
   (doom-modeline-bar :background bg)
   (doom-modeline-buffer-file :foreground modeline-fg :weight 'bold)
   (doom-modeline-buffer-path :foreground modeline-fg)
   (doom-modeline-project-dir :foreground modeline-fg :weight 'bold)
   (doom-modeline-info :foreground modeline-fg)
   ;; dired: same idea as ls in the terminal
   (dired-directory :foreground blue :weight 'bold)
   (dired-symlink :foreground dark-cyan :weight 'bold :underline t)
   ;; headings: one hue per level (org and markdown share them)
   (outline-1 :foreground base8 :weight 'bold)
   (outline-2 :foreground coral :weight 'bold)
   (outline-3 :foreground gold  :weight 'bold)
   (outline-4 :foreground sage  :weight 'bold)
   (outline-5 :foreground peach :weight 'bold)
   (outline-6 :foreground aqua  :weight 'bold)
   (outline-7 :foreground rose  :weight 'bold)
   (outline-8 :foreground base7 :weight 'bold)
   ((org-level-1 &override) :inherit 'outline-1 :foreground base8)
   ((org-level-2 &override) :inherit 'outline-2 :foreground coral)
   ((org-level-3 &override) :inherit 'outline-3 :foreground gold)
   ((org-level-4 &override) :inherit 'outline-4 :foreground sage)
   ((org-level-5 &override) :inherit 'outline-5 :foreground peach)
   ((org-level-6 &override) :inherit 'outline-6 :foreground aqua)
   (markdown-header-face-1 :inherit 'outline-1)
   (markdown-header-face-2 :inherit 'outline-2)
   (markdown-header-face-3 :inherit 'outline-3)
   (markdown-header-face-4 :inherit 'outline-4)
   (markdown-header-face-5 :inherit 'outline-5)
   (markdown-header-face-6 :inherit 'outline-6)
   (markdown-header-delimiter-face :foreground base5)
   ;; inline structure
   (link :foreground aqua :underline t)
   (org-link :foreground aqua :underline t)
   (markdown-link-face :foreground aqua)
   (markdown-url-face :foreground base6 :underline t)
   (markdown-bold-face :foreground base8 :weight 'bold)
   (markdown-italic-face :foreground gold :slant 'italic)
   (markdown-inline-code-face :foreground peach :background base1)
   ((org-code &override) :foreground peach)
   (markdown-blockquote-face :foreground sage :slant 'italic)
   ((org-quote &override) :foreground sage :slant 'italic)
   (markdown-list-face :foreground coral)
   (markdown-gfm-checkbox-face :foreground gold :weight 'bold)
   (markdown-metadata-key-face :foreground coral)
   (markdown-metadata-value-face :foreground fg-alt)
   ((org-tag &override) :foreground sage)
   ((org-document-title &override) :foreground base8 :weight 'bold)))

;;; doom-prism-light-theme.el ends here
