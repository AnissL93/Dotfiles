#!/usr/bin/env python3
"""Export sioyek highlights to Obsidian, one note per book, in the KOReader importer's callout style.

usage: sioyek-export            (rewrites every book note it owns; safe to run any time)
env:   SIOYEK_DATA  sioyek's data dir   (default ~/Library/Application Support/sioyek)
       SIOYEK_OUT   notes folder        (default ~/Sync/WorkNotes/02_Sources/Books/Highlights)
"""
import os, sqlite3, subprocess, sys, tempfile
from bisect import bisect_right
from datetime import datetime
from pathlib import Path

DATA = Path(os.environ.get("SIOYEK_DATA", "~/Library/Application Support/sioyek")).expanduser()
OUT = Path(os.environ.get("SIOYEK_OUT", "~/Sync/WorkNotes/02_Sources/Books/Highlights")).expanduser()
MARKER = "generated-by: sioyek-export"

# sioyek highlight letter (h + a..z) -> callout colours the KOReader importer's CSS defines
COLOURS = {"y": "yellow", "x": "yellow", "r": "red", "w": "red", "g": "green", "j": "green", "f": "green",
           "b": "blue", "n": "blue", "o": "orange", "z": "orange", "h": "orange", "v": "purple", "d": "purple",
           "m": "purple", "a": "purple", "s": "cyan", "t": "cyan", "i": "gray", "e": "gray", "k": "olive",
           "l": "olive", "q": "olive", "u": "olive", "c": "orange", "p": "red"}

# sioyek stacks pages with no gap, so a highlight's page comes from cumulative page heights
HEIGHTS_JS = """var d = Document.openDocument(scriptArgs[0]), out = [];
for (var i = 0; i < d.countPages(); i++) { var b = d.loadPage(i).getBounds(); out.push(b[3] - b[1]); }
print(out.join(" "));"""


def page_starts(path):
    with tempfile.NamedTemporaryFile("w", suffix=".js") as js:
        js.write(HEIGHTS_JS)
        js.flush()
        r = subprocess.run(["mutool", "run", js.name, path], capture_output=True, text=True)
    starts, acc = [], 0.0
    for h in r.stdout.split():
        starts.append(acc)
        acc += float(h)
    return starts


def page_of(starts, y):
    return bisect_right(starts, y) if starts else 0  # 0 = file moved or unreadable


def quote(text):
    return "\n".join("> " + line for line in text.strip().splitlines())


def day(ts):
    try:
        return datetime.fromisoformat(ts[:19]).strftime("%b %-d, %Y")
    except (TypeError, ValueError):
        return ""


def note(path, rows):
    starts = page_starts(path) if os.path.exists(path) else []
    marks = sorted(((page_of(starts, r[4]), r) for r in rows), key=lambda m: (m[0], m[1][4]))
    title = Path(path).stem
    out = [f'---\nTitle: "{title}"\nSource: "{path}"\nHighlight Count: {len(rows)}\n{MARKER}\n---\n']
    for page, (text, comment, kind, created, _) in marks:
        out.append(f"> [!{COLOURS.get(kind, 'yellow')}] Page {page}{' • ' + day(created) if day(created) else ''}\n{quote(text or '')}")
        if comment and comment.strip():
            out.append(f">\n> ---\n{quote(comment)}")
        out.append("")
    return title, "\n".join(out)


def main():
    paths = {h: p for p, h in sqlite3.connect(DATA / "local.db").execute("select path, hash from document_hash")}
    books = {}
    for row in sqlite3.connect(DATA / "shared.db").execute(
            "select document_path, desc, text_annot, type, creation_time, begin_y from highlights"):
        books.setdefault(row[0], []).append(row[1:])
    OUT.mkdir(parents=True, exist_ok=True)
    for doc, rows in books.items():
        path = paths.get(doc)
        if not path:
            print(f"skip: no file known for {doc}", file=sys.stderr)
            continue
        title, text = note(path, rows)
        dst = OUT / f"{title}.md"
        if dst.exists() and MARKER not in dst.read_text():
            print(f"skip: {dst.name} exists and was not made by sioyek-export", file=sys.stderr)
            continue
        dst.write_text(text)
        print(f"{len(rows):3} highlights -> {dst}")


if __name__ == "__main__":
    main()
