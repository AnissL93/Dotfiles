#!/usr/bin/env python3
"""Compute a theme's colours from its one-line design spec (OKLCH), then rebuild its emacs theme.

usage: design NAME...        rewrite the colours of NAME.conf from its `# design:` line

The spec is a comment in the .conf, e.g.
  # design: dark base=248 accent=200 border=235 syntax=12,245,190,295,70
    mode        light | dark
    base        hue of the tinted neutrals (bg ... fg); base_c = their chroma (default .012 / .028)
    accent      hue of the highlight (status bar, selection tab); accent_l / accent_c override
                lightness (default .50 light, .74 dark) and chroma (default .065); its text colour
                (accent_fg) is picked light or dark, whichever reads better
    border      hue of window borders
    syntax      hues of keyword, function, string, type, number — all at one lightness and chroma
Colours are designed, not sampled: tinted neutrals, muted accents, evenly weighted syntax.
"""
import os
import re
import subprocess
import sys
from importlib.machinery import SourceFileLoader

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.realpath(__file__))
o = SourceFileLoader("oklch", os.path.join(HERE, "oklch")).load_module().to_hex
ANSI = [20, 150, 80, 245, 320, 200]  # red green yellow blue magenta cyan


def lum(h):
    c = [int(h[i:i + 2], 16) / 255 for i in (1, 3, 5)]
    c = [x / 12.92 if x <= .03928 else ((x + .055) / 1.055) ** 2.4 for x in c]
    return .2126 * c[0] + .7152 * c[1] + .0722 * c[2]


def contrast(a, b):
    x, y = sorted([lum(a), lum(b)])
    return (y + .05) / (x + .05)


def palette(spec):
    light = spec["mode"] == "light"
    B = float(spec["base"])
    bc = float(spec.get("base_c", .012 if light else .028))
    A, R = float(spec["accent"]), float(spec["border"])
    kw, fn, st, ty, nu = (float(h) for h in spec["syntax"].split(","))
    al = float(spec.get("accent_l", .50 if light else .74))
    ac = float(spec.get("accent_c", .065))
    if light:
        p = dict(bg=o(.965, bc * .7, B), bg_alt=o(.94, bc, B), bg_hl=o(.915, bc * 1.2, B),
                 sel=o(.87, .03, A), dim=o(.76, bc * 1.2, B), mid=o(.52, bc * 2.5, B),
                 fg=o(.29, bc * 1.6, B), bright=o(.21, bc * 1.6, B), border=o(.6, .05, R),
                 comment=o(.62, bc * 1.6, B), punct=o(.5, bc * 2, B), err=o(.5, .12, 22))
        sl, sc, n, b = .49, .075, .5, .58
    else:
        p = dict(bg=o(.24, bc, B), bg_alt=o(.21, bc * .9, B), bg_hl=o(.28, bc * 1.05, B),
                 sel=o(.34, .03, A), dim=o(.43, bc, B), mid=o(.7, bc * 1.2, B),
                 fg=o(.9, bc * .6, B), bright=o(.96, bc * .4, B), border=o(.68, .05, R),
                 comment=o(.58, bc, B), punct=o(.7, bc * 1.2, B), err=o(.7, .11, 22))
        sl, sc, n, b = .77, .07, .72, .8
    p["accent"] = o(al, ac, A)
    ink, paper = o(.21, .02, A), o(.975, .006, A)
    p["accent_fg"] = max((ink, paper), key=lambda c: contrast(c, p["accent"]))
    p.update(keyword=o(sl, sc, kw), function=o(sl, sc, fn), string=o(sl, sc, st),
             type=o(sl, sc, ty), number=o(sl, sc, nu))
    p.update(warn=p["number"], ok=o(sl, sc * .9, 160))
    lo = [o(n, .075, h) for h in ANSI]
    hi = [o(b, .07 if light else .065, h) for h in ANSI]
    if light:   # colour7/15 dark: prompts print "bold white" text
        cols = [p["bright"], *lo, p["mid"], p["comment"], *hi, p["fg"]]
    else:
        cols = [p["bg"], *lo, o(.84, bc * .7, B), p["dim"], *hi, p["bright"]]
    p.update({f"color{i}": c for i, c in enumerate(cols)})
    return p


def main(names):
    for name in names:
        path = os.path.join(HERE, name + ".conf")
        s = open(path).read()
        m = re.search(r"^# design: (\w+)(.*)$", s, re.M)
        if not m:
            sys.exit(f"{name}.conf has no '# design:' line")
        spec = dict(kv.split("=") for kv in m.group(2).split() if "=" in kv)
        spec["mode"] = m.group(1)
        p = palette(spec)
        for k, v in p.items():
            s, count = re.subn(rf"^({k}\s*= )#[0-9a-fA-F]{{6}}", rf"\g<1>{v}", s, flags=re.M)
            if not count:
                sys.exit(f"{name}.conf: no '{k} = #......' line")
        open(path, "w").write(s)
        subprocess.run([os.path.join(HERE, "doom-theme"), name, "--force"], stdout=subprocess.DEVNULL, check=True)
        worst = min(contrast(p[k], p["bg"]) for k in ("keyword", "function", "string", "type", "number", "err"))
        print(f"{name:15} fg {contrast(p['fg'], p['bg']):4.1f}  accent {contrast(p['accent_fg'], p['accent']):4.1f}"
              f"  syntax >= {worst:.1f}")


if __name__ == "__main__":
    main(sys.argv[1:]) if sys.argv[1:] else sys.exit(__doc__)
