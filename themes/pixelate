#!/usr/bin/env python3
"""Turn a picture into an old-school pixel-art wallpaper (or, with --photo, just fit it to the screen).

usage: pixelate SRC OUT WIDTH HEIGHT [--px 10] [--palette '#rrggbb,...' | --colors 16] [--spread 36]
                [--center 0.45,0.5] [--fill blur|mirror|crop] [--photo] [--duotone DARK,LIGHT [--mix 70]]
       pixelate SRC OUT WIDTH HEIGHT --art BG [--scale 2.5]   already pixel art: crisp upscale, centred on BG
       pixelate SRC --sample                                  the picture's 16 main colours, most used first

Crops to the screen ratio; for a screen much wider than the picture it crops 15% of the height and
pads the sides (--fill). Then shrinks to a WIDTH/px x HEIGHT/px grid, maps every cell to a small
palette with a 4x4 Bayer dither and scales back up with hard pixel edges. Without --palette it picks
--colors colours from the picture; prints the palette it used.
"""
import argparse
import sys
import numpy as np
from PIL import Image, ImageEnhance, ImageFilter, ImageOps

p = argparse.ArgumentParser()
p.add_argument("src"); p.add_argument("out", nargs="?")
p.add_argument("width", type=int, nargs="?"); p.add_argument("height", type=int, nargs="?")
p.add_argument("--px", type=int, default=10, help="screen pixels per art pixel")
p.add_argument("--palette", help="comma-separated hex colours; default: picked from the picture")
p.add_argument("--colors", type=int, default=16)
p.add_argument("--spread", type=float, default=36, help="dither strength (0 = flat colour bands)")
p.add_argument("--center", default="0.45,0.5",
               help="crop focus x,y in 0..1; on ultrawide x also splits the padding (1 = pad left only)")
p.add_argument("--fill", choices=["blur", "mirror", "crop"], default="blur",
               help="ultrawide padding: blurred edge colour, the mirrored picture (only if no subject near that edge),\n"
                    "or none: crop to the screen ratio whatever it costs (repeating patterns)")
p.add_argument("--photo", action="store_true", help="full resolution, no pixels/palette: only crop/pad")
p.add_argument("--sample", action="store_true", help="print the 16 main colours with their share, then exit")
p.add_argument("--duotone", help="DARK,LIGHT: recolour (blend a duotone of the picture in) before anything else")
p.add_argument("--mix", type=float, default=70, help="duotone share in %%")
p.add_argument("--art", metavar="BG", help="picture is already pixel art: scale by --scale with hard edges, centre on BG")
p.add_argument("--scale", type=float, default=2.5)
a = p.parse_args()
if not a.sample and a.height is None:
    p.error("OUT WIDTH HEIGHT are required (except with --sample)")
rgb = lambda c: tuple(int(c.strip()[i:i + 2], 16) for i in (1, 3, 5))

if a.sample:
    small = Image.open(a.src).convert("RGB")
    small = small.resize((200, max(1, round(200 * small.height / small.width))))
    q = small.quantize(16, method=Image.Quantize.MEDIANCUT)
    pal = q.getpalette()
    total = small.width * small.height
    for n, i in sorted(q.getcolors(), reverse=True):
        print("%5.1f%%  #%02x%02x%02x" % (100 * n / total, *pal[i * 3:i * 3 + 3]))
    sys.exit()
if a.art:
    art = Image.open(a.src).convert("RGB")
    art = art.resize((round(art.width * a.scale), round(art.height * a.scale)), Image.NEAREST)
    out = Image.new("RGB", (a.width, a.height), rgb(a.art))
    out.paste(art, ((a.width - art.width) // 2, (a.height - art.height) // 2))
    out.save(a.out)
    sys.exit()
if a.photo:
    a.px = 1

gw, gh = a.width // a.px, a.height // a.px
img = Image.open(a.src).convert("RGB")
if a.duotone:                                  # grey -> DARK..LIGHT gradient, blended in, then +20% saturation
    dark, light = (np.array(rgb(c), float) for c in a.duotone.split(","))
    grey = np.asarray(img.convert("L"), float)[:, :, None] / 255
    tone = Image.fromarray((dark + grey * (light - dark)).astype(np.uint8))
    img = ImageEnhance.Color(Image.blend(img, tone, a.mix / 100)).enhance(1.2)
center = tuple(map(float, a.center.split(",")))
if a.fill == "crop" or gw / gh * 0.85 <= img.width / img.height:   # losing <= 15% of the height is fine
    img = ImageOps.fit(img, (gw, gh), Image.LANCZOS, centering=center)
else:                                          # ultrawide: crop 15%, pad the rest (--fill)
    img = ImageOps.fit(img, (img.width, round(img.height * 0.85)), Image.LANCZOS, centering=center)
    small = img.resize((round(img.width * gh / img.height), gh), Image.LANCZOS)
    left = round((gw - small.width) * center[0])   # focus x=1 keeps the picture's right edge on screen
    right = gw - small.width - left
    mode = "symmetric" if a.fill == "mirror" else "edge"
    img = Image.fromarray(np.pad(np.asarray(small), ((0, 0), (left, right), (0, 0)), mode=mode))
    if a.fill == "blur":                       # blur the padding and fade it into the picture
        img = img.filter(ImageFilter.GaussianBlur(gh / 18))
        img.paste(small, (left, 0))
        x = np.arange(gw, dtype=float)
        seam = np.minimum(x - left if left else np.inf, left + small.width - x if right else np.inf)
        ramp = np.clip(seam / (gh / 12), 0, 1)
        img = Image.composite(img, img.filter(ImageFilter.GaussianBlur(gh / 18)),
                              Image.fromarray((np.tile(ramp, (gh, 1)) * 255).astype(np.uint8)))
if a.photo:
    img.save(a.out)
    sys.exit()
img = ImageEnhance.Contrast(ImageEnhance.Color(img).enhance(1.35)).enhance(1.12)

if a.palette:
    pal = np.array([rgb(c) for c in a.palette.split(",")], float)
else:
    pal = np.array(img.quantize(a.colors, method=Image.Quantize.MEDIANCUT).getpalette()[:a.colors * 3],
                   float).reshape(-1, 3)
bayer = np.array([[0, 8, 2, 10], [12, 4, 14, 6], [3, 11, 1, 9], [15, 7, 13, 5]]) / 16 - 0.5
px = np.asarray(img, float) + np.tile(bayer, (gh // 4 + 1, gw // 4 + 1))[:gh, :gw, None] * a.spread
idx = ((px[:, :, None, :] - pal[None, None]) ** 2).sum(-1).argmin(-1)
art = Image.fromarray(pal[idx].astype(np.uint8)).resize((gw * a.px, gh * a.px), Image.NEAREST)
out = Image.new("RGB", (a.width, a.height))
out.paste(art, ((a.width - art.width) // 2, (a.height - art.height) // 2))
out.save(a.out)
print(",".join("#%02x%02x%02x" % tuple(int(v) for v in c) for c in pal))
