         "permission": c(4), "permissionShimmer": c(12), "suggestion": c(4), "remember": c(4),
         "claudeBlue_FOR_SYSTEM_SPINNER": c(4), "claudeBlueShimmer_FOR_SYSTEM_SPINNER": c(12),
         "rate_limit_fill": c(4), "rate_limit_empty": t["dim"], "briefLabelYou": c(4), "ide": c(4),
         "planMode": c(6), "merged": c(5), "background": c(6),
         "promptBorder": t["dim"], "promptBorderShimmer": t["mid"],
         "text": t["fg"], "inverseText": t["bg"], "inactive": t["comment"], "inactiveShimmer": t["mid"],
         "subtle": t["dim"], "success": t["ok"], "error": t["err"], "warning": t["warn"], "warningShimmer": c(11),
         "diffAdded": blend(t["bg"], c(2), .3), "diffRemoved": blend(t["bg"], c(1), .3),
         "diffAddedDimmed": blend(t["bg"], c(2), .15), "diffRemovedDimmed": blend(t["bg"], c(1), .15),
