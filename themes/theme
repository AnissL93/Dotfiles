SHARED = (alacritty, firefox, obsidian, rmpc, vscode, emacs, claude, nvim, zathura)
LINUX = (xresources, gtk_scheme, dunst, cursor, fcitx5, wallpaper, x11_reload)
MACOS = (dark_mode, sketchybar, borders, codeisland, cursor_mac, wallpaper_mac)


def apply(name):
    t = load(name)
    for step in SHARED + (MACOS if MAC else LINUX):
        step(t)
    write(f"{STATE}/current", name + "\n")
    print(f"theme: {t['name']}. Restart firefox; new " + ("windows" if MAC else "st windows") + " and apps pick it up.")


def main(argv):
    if not argv:
        cur = current()
        ts = {n: load(n) for n in themes()}
        for mode in ("light", "dark"):
            print(f"{mode}:")
            for n, t in ts.items():
                if t.get("mode", "dark") == mode:
                    print(("* " if n == cur else "  ") + f"{n:16} {t['name']}")
    elif argv[0] == "--random":
        import random
        cur, mode = current(), argv[1] if len(argv) > 1 else None
        apply(random.choice([n for n in themes() if n != cur and mode in (None, load(n).get("mode", "dark"))]))
    elif argv[0] == "--wallpaper":
        (wallpaper_mac if MAC else wallpaper)(load(argv[1] if len(argv) > 1 else current()))
    elif argv[0] in themes():
        apply(argv[0])
    else:
        sys.exit(f"unknown theme: {argv[0]} (have: {', '.join(themes())})")


if __name__ == "__main__":
    main(sys.argv[1:])
