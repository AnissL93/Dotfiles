#!/usr/bin/env python3
"""Colour theme manager for the whole desktop.

usage: theme              list themes (* = current)
       theme NAME         apply NAME.conf to alacritty, firefox, obsidian, rmpc, vscode, emacs, claude code, neovim, zathura,
                          wallpaper, and per platform:
                            Linux: dwm, dmenu, st, dunst, fcitx5, slock, cursor
                            macOS: light/dark mode, sketchybar, borders, CodeIsland, pointer
       theme --wallpaper [NAME]  only set the wallpaper of the current (or NAME) theme;
                          used by xinitrc and changebg
       theme --random [light|dark]  apply a random theme (other than the current one)

A theme is one NAME.conf palette next to this script. To add one: copy a .conf, change the
colours / wallpapers (or write `base = OTHER` and only the keys that differ), and (for emacs) add a doom theme with the name in `emacs_theme`.
Optional `bar` / `bar_fg` colour only the dwm / sketchybar bar (default: accent / accent_fg).
Applies live: dwm/dmenu bar, firefox light/dark, alacritty, dunst, emacs, vscode, slock (next lock), wallpaper. Needs a restart: firefox,
already-open st windows, cursor in already-open apps.
"""
import json
import os
import re
import subprocess
import sys
import tempfile
import zipfile

sys.dont_write_bytecode = True   # obsidian() loads ./oklch: no __pycache__ in the repo

HERE = os.path.dirname(os.path.realpath(__file__))
STATE = os.path.expanduser("~/.config/theme")
HOME = os.path.expanduser("~")
DESK = os.path.join(os.path.dirname(os.path.dirname(HERE)), "desktop", "linux")   # personal-infra/desktop/linux
_ff = subprocess.run([os.path.join(DESK, "bin", "ff-profile")], capture_output=True, text=True)
FF_CHROME = os.path.join(_ff.stdout.strip(), "chrome") if _ff.returncode == 0 else None  # None: no profile yet
CURSOR_GEN = os.path.join(DESK, "cursors", "make-amber-cursors.py")
MAC = sys.platform == "darwin"
# Obsidian vaults that follow the desktop theme (the others keep their own look)
if MAC:
    VSCODE_SETTINGS = f"{HOME}/Library/Application Support/Code/User/settings.json"
    OBSIDIAN_VAULTS = [f"{HOME}/Sync/WorkNotes"]
else:
    VSCODE_SETTINGS = f"{HOME}/.config/Code/User/settings.json"
    OBSIDIAN_VAULTS = ["/srv/sync/WorkNotes"]
# wallpapers: the .conf files name them; they live in github.com/AnissL93/assets and are downloaded on first use
WALLPAPER_URL = "https://raw.githubusercontent.com/AnissL93/assets/main/wallpapers"
WALLPAPERS = f"{HOME}/.local/share/wallpapers"
OBSIDIAN_SNIPPETS = os.path.join(os.path.dirname(HERE), "obsidian")  # dotfiles/obsidian/*.css


def load(name):
    t = {}
    for line in open(os.path.join(HERE, name + ".conf")):   # "key = value", "#" lines are comments
        if "=" in line and not line.lstrip().startswith("#"):
            k, v = (x.strip() for x in line.split("=", 1))
            t[k] = os.path.expanduser(v)
    # "base = OTHER": start from OTHER's palette (e.g. the same colours with another wallpaper)
    return {**load(t["base"]), **t} if "base" in t else t


def themes():
    return sorted(f[:-5] for f in os.listdir(HERE) if f.endswith(".conf"))


def current():
    try:
        return open(f"{STATE}/current").read().strip()
    except OSError:
        return "amber"


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(text)


def run(*cmd):
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except FileNotFoundError:                    # program not installed (e.g. on a fresh machine)
        pass


def capture(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True).stdout
    except FileNotFoundError:
        return ""


# ---- per-app writers -------------------------------------------------------------------

def gtk_scheme(t):
    # web pages follow light/dark live: firefox (and GTK apps) read this through xdg-desktop-portal
    run("gsettings", "set", "org.gnome.desktop.interface", "color-scheme",
        "prefer-dark" if t.get("mode", "dark") == "dark" else "default")


def xresources(t):
    lines = [f"! generated by `theme` from {t['name']}; do not edit",
             f"dwm.normbgcolor: {t['bg']}", f"dwm.normbordercolor: {t['dim']}",
             f"dwm.normfgcolor: {t['fg']}", f"dwm.selbgcolor: {t.get('bar', t['accent'])}",
             f"dwm.selfgcolor: {t.get('bar_fg', t['accent_fg'])}", f"dwm.selbordercolor: {t['border']}",
             f"st.background: {t['bg']}", f"st.foreground: {t['fg']}", f"st.cursorColor: {t['fg']}",
             *(f"st.color{i}: {t[f'color{i}']}" for i in range(16)),
             f"slock.init: {t['bg']}", f"slock.input: {t['accent']}", f"slock.failed: {t['err']}",
             f"Xcursor.theme: {t['cursor']}"]
    write(f"{STATE}/xresources", "\n".join(lines) + "\n")


def alacritty(t):
    c = lambda i: t[f"color{i}"]
    names = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
    write(f"{HOME}/.config/alacritty/theme.toml", f"""# generated by `theme` from {t['name']}; do not edit
[colors.primary]
background = "{t['bg']}"
foreground = "{t['fg']}"
bright_foreground = "{t['bright']}"

[colors.cursor]
text = "{t['bg']}"
cursor = "{t['fg']}"

[colors.selection]
text = "{t['bright']}"
background = "{t['sel']}"

[colors.normal]
""" + "".join(f'{n} = "{c(i)}"\n' for i, n in enumerate(names)) + "\n[colors.bright]\n"
          + "".join(f'{n} = "{c(i + 8)}"\n' for i, n in enumerate(names)))


