def cursor_mac(t):
    """pointer fill/outline = accent/bg; size stays as set in System Settings; live.
    The values must be a dict of reals: a string there crashes every app that sets the cursor."""
    ua = "com.apple.universalaccess"
    for key, c in (("cursorFill", t["accent"]), ("cursorOutline", t["bg"])):
        rgb = [int(c.lstrip("#")[i:i + 2], 16) / 255 for i in (0, 2, 4)]
        args = [a for k, v in zip(("red", "green", "blue", "alpha"), rgb + [1]) for a in (k, "-float", str(v))]
        run("defaults", "write", ua, key, "-dict", *args)
        xml = subprocess.run(f"defaults export {ua} - | plutil -extract {key} xml1 -o - -",
                             shell=True, capture_output=True, text=True).stdout
        if xml.count("<real>") != 4:          # not what macOS expects: back to the default pointer
            run("defaults", "delete", ua, "cursorFill")
            run("defaults", "delete", ua, "cursorOutline")
            print(f"theme: could not set {key} (needs Full Disk Access for the terminal?); pointer reset")
            return


def wallpaper_mac(t):
    res = re.findall(r"Resolution: (\d+) x (\d+)", capture("system_profiler", "SPDisplaysDataType"))
    # ponytail: one image on every screen, the ultrawide one if any screen is wider than 2:1;
    # per-screen images need display ids
    wide = any(int(w) / int(h) > 2 for w, h in res)
    img = wallpaper_file(t["wallpaper_3440"] if wide else t["wallpaper_2560"])
    if img:
        run("osascript", "-e", f'tell application "System Events" to set picture of every desktop to POSIX file "{img}"')


