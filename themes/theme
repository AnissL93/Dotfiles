def fcitx5(t):
    """fcitx5 classic-UI theme `desktop` (input candidate window + menus), selected and reloaded live."""
    stock = "/usr/share/fcitx5/themes/" + ("default" if t.get("mode") == "light" else "default-dark")
    if not os.path.isdir(stock):                 # fcitx5 not installed
        return
    d = f"{HOME}/.local/share/fcitx5/themes/desktop"
    for png in ("arrow.png", "next.png", "prev.png", "radio.png"):
        if os.path.lexists(f"{d}/{png}"):
            os.remove(f"{d}/{png}")
        os.makedirs(d, exist_ok=True)
        os.symlink(f"{stock}/{png}", f"{d}/{png}")
    margin = lambda sec, n: f"[{sec}]\nLeft={n}\nRight={n}\nTop={n}\nBottom={n}\n\n"
    write(f"{d}/theme.conf", f"""# generated by `theme` from {t['name']}; do not edit
[Metadata]
Name=Desktop ({t['name']})
Version=1
Author=theme
Description=follows the desktop theme
ScaleWithDPI=True

[InputPanel]
NormalColor={t['fg']}
HighlightCandidateColor={t['accent_fg']}
HighlightColor={t['accent']}
HighlightBackgroundColor={t['sel']}
PageButtonAlignment=Last Candidate

[InputPanel/Background]
Color={t['bg']}
BorderColor={t['accent']}
BorderWidth=2

[InputPanel/Highlight]
Color={t['accent']}

[InputPanel/PrevPage]
Image=prev.png

[InputPanel/NextPage]
Image=next.png

[Menu]
NormalColor={t['fg']}
HighlightCandidateColor={t['accent_fg']}

[Menu/Background]
Color={t['bg']}
BorderColor={t['accent']}
BorderWidth=2

[Menu/Highlight]
Color={t['accent']}

[Menu/Separator]
Color={t['dim']}

[Menu/CheckBox]
Image=radio.png

[Menu/SubMenu]
Image=arrow.png

""" + "".join(margin(s, n) for s, n in (
        ("InputPanel/TextMargin", 5), ("InputPanel/ContentMargin", 2), ("InputPanel/Background/Margin", 2),
        ("InputPanel/Highlight/Margin", 5), ("InputPanel/PrevPage/ClickMargin", 5),
        ("InputPanel/NextPage/ClickMargin", 5), ("Menu/Background/Margin", 2), ("Menu/ContentMargin", 2),
        ("Menu/Highlight/Margin", 5), ("Menu/TextMargin", 5))))
    # select it (keep fcitx5's other classicui settings); accent/dark-theme switching would override it
    conf = f"{HOME}/.config/fcitx5/conf/classicui.conf"
    want = {"Theme": "desktop", "DarkTheme": "desktop", "UseDarkTheme": "False", "UseAccentColor": "False"}
    lines = open(conf).read().splitlines() if os.path.exists(conf) else []
    lines = [l for l in lines if l.split("=", 1)[0] not in want] + [f"{k}={v}" for k, v in want.items()]
    write(conf, "\n".join(lines) + "\n")
    run("gdbus", "call", "--session", "--dest", "org.fcitx.Fcitx5", "--object-path", "/controller",
        "--method", "org.fcitx.Fcitx.Controller1.ReloadAddonConfig", "classicui")


