         "composerSidebarBackground": t["bg_alt"], "selectionBg": t["sel"],
         "bashMessageBackgroundColor": t["bg_alt"], "memoryBackgroundColor": t["bg_hl"],
         **{f"{n}_FOR_SUBAGENTS_ONLY": c(i) for n, i in
            (("red", 1), ("green", 2), ("yellow", 3), ("blue", 4), ("purple", 5), ("cyan", 6))},
         "orange_FOR_SUBAGENTS_ONLY": t["number"], "pink_FOR_SUBAGENTS_ONLY": c(13)}
