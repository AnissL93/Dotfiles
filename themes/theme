def dunst(t):
    write(f"{HOME}/.config/dunst/dunstrc.d/theme.conf", f"""# generated by `theme` from {t['name']}; do not edit
[global]
    frame_color = "{t['border']}"

[urgency_low]
    background = "{t['bg']}"
    foreground = "{t['mid']}"
    frame_color = "{t['dim']}"

[urgency_normal]
    background = "{t['bg']}"
    foreground = "{t['fg']}"
    frame_color = "{t['border']}"

[urgency_critical]
    background = "{t['bg']}"
    foreground = "{t['err']}"
    frame_color = "{t['err']}"
""")
    # restart instead of `dunstctl reload`: there can be one dunst per D-Bus session
    # (dbus-launch in xinitrc + systemd), and reload only reaches one of them.
    # D-Bus starts a fresh dunst with the new colours on the next notification.
    run("pkill", "-x", "dunst")


def obsidian(t):
    """CSS snippet `desktop-theme` in each vault + light/dark base theme.
    Obsidian reloads changed snippets live; the light/dark switch applies on next start.
    Calmer than the bar and terminal: every colour at `soft` (default 60%) of its chroma, same lightness."""
    from importlib.machinery import SourceFileLoader
    ok = SourceFileLoader("oklch", os.path.join(HERE, "oklch")).load_module()
    soft = lambda c: ok.to_hex(*(lambda L, C, H: (L, C * float(t.get('soft', .6)), H))(*ok.from_hex(c)))
    t = {k: soft(v) if isinstance(v, str) and re.fullmatch(r"#[0-9a-fA-F]{6}", v) else v for k, v in t.items()}
    rgb = lambda k: ", ".join(str(int(t[k][i:i + 2], 16)) for i in (1, 3, 5))
    r, g, b = (int(t["accent"][i:i + 2], 16) / 255 for i in (1, 3, 5))
    import colorsys
    h, l, sat = colorsys.rgb_to_hls(r, g, b)
    fg_light = sum(int(t["accent_fg"][i:i + 2], 16) for i in (1, 3, 5)) > 384
    mix = lambda c, to, f: "#" + "".join(f"{round(int(c[i:i + 2], 16) * (1 - f) + to * f):02x}" for i in (1, 3, 5))
    t = {**t, "accent_hl": mix(t["accent"], 0 if fg_light else 255, 0.18)}
    ink = ", ".join(str(int(t["accent_fg"][i:i + 2], 16)) for i in (1, 3, 5))
    # accent as text on the page: a pastel (watercolor) accent is unreadable there, use the keyword colour
    lum = lambda c: sum(w * (lambda x: x / 12.92 if x <= .03928 else ((x + .055) / 1.055) ** 2.4)(int(c[i:i + 2], 16) / 255)
                        for w, i in ((.2126, 1), (.7152, 3), (.0722, 5)))
    x, y = sorted([lum(t["accent"]), lum(t["bg"])])
    ink_accent = "accent" if (y + .05) / (x + .05) >= 3 else "keyword"
    v = {
        # Obsidian base scale and surfaces
        "color-base-00": "bg", "color-base-05": "bg_alt", "color-base-10": "bg_hl", "color-base-20": "bg_alt",
        "color-base-25": "sel", "color-base-30": "dim", "color-base-35": "dim", "color-base-40": "mid",
        "color-base-50": "mid", "color-base-60": "fg", "color-base-70": "fg", "color-base-100": "bright",
        "background-primary": "bg", "background-primary-alt": "bg_alt", "background-secondary": "bg_alt",
        "background-secondary-alt": "bg_hl", "background-modifier-border": "dim",
        "background-modifier-hover": "bg_hl", "background-modifier-active-hover": "sel",
        "titlebar-background": "accent", "titlebar-background-focused": "accent", "ribbon-background": "accent",
        "tab-container-background": "accent", "tab-background-active": "bg", "divider-color": "dim",
        "scrollbar-thumb-bg": "dim", "scrollbar-active-thumb-bg": "mid",
        # text and accents
        "text-normal": "fg", "text-muted": "mid", "text-faint": "dim", "text-accent": ink_accent,
        "text-accent-hover": "border", "text-on-accent": "accent_fg", "text-selection": "sel", "text-error": "err",
        "interactive-accent": "accent", "interactive-accent-hover": "border", "interactive-normal": "bg_hl",
        "interactive-hover": "sel", "icon-color": "mid", "icon-color-hover": "fg", "icon-color-active": ink_accent,
        "icon-color-focused": "fg", "link-color": "function", "link-color-hover": "keyword",
        "link-external-color": "function", "link-unresolved-color": "mid", "tag-color": "type",
        "tag-background": "bg_hl",
        "h1-color": "keyword", "h2-color": "function", "h3-color": "type", "h4-color": "string",
        "h5-color": "number", "h6-color": "mid",
        # code
        "code-background": "bg_hl", "code-normal": "fg", "code-comment": "comment", "code-keyword": "keyword",
        "code-string": "string", "code-function": "function", "code-value": "number", "code-property": "type",
        "code-tag": "type", "code-operator": "punct", "code-punctuation": "punct", "code-important": "err",
        # callout / colour palette
        "color-red": "err", "color-orange": "warn", "color-yellow": "color3", "color-green": "ok",
        "color-cyan": "color6", "color-blue": "color4", "color-purple": "color5", "color-pink": "color13",
        # RetroNotes' own "ink" variables
        "main-ink": "fg", "main-ink-muted": "mid", "main-ink-fainted": "dim", "secondary-ink": "function",
        "secondary-ink-muted": "mid", "secondary-ink-fainted": "dim", "light-ink": "accent_fg",
        "light-ink-alt": "accent_fg", "leather-color": "accent", "leather-color-alt": "accent_hl", "bold-accent-ink": "keyword",
        "italic-accent-ink": "type",
    }
    rgbs = {"color-base-00-rgb": "bg", "color-base-50-rgb": "mid", "main-ink-rgb": "fg",
            "secondary-ink-rgb": "function", "leather-color-rgb": "accent",
            **{f"color-{c}-rgb": k for c, k in [("red", "err"), ("orange", "warn"), ("yellow", "color3"),
               ("green", "ok"), ("cyan", "color6"), ("blue", "color4"), ("purple", "color5"), ("pink", "color13")]}}
    css = (f"/* generated by `theme` from {t['name']}; do not edit */\n"
           "body.theme-light, body.theme-dark, .theme-light, .theme-dark {\n"
           + "".join(f"  --{n}: {t[k]} !important;\n" for n, k in v.items())
           + "".join(f"  --{n}: {rgb(k)} !important;\n" for n, k in rgbs.items())
           + f"  --light-ink-muted: rgba({ink}, 0.75) !important;\n  --light-ink-fainted: rgba({ink}, 0.5) !important;\n"
           + f"  --accent-h: {h * 360:.0f} !important;\n  --accent-s: {sat * 100:.0f}% !important;\n"
           + f"  --accent-l: {l * 100:.0f}% !important;\n}}\n")
    for vault in OBSIDIAN_VAULTS:
        cfg = os.path.join(vault, ".obsidian")
        if not os.path.isdir(cfg):
            continue
        write(os.path.join(cfg, "snippets", "desktop-theme.css"), css)
        # hand-written snippets kept in dotfiles/obsidian (copied: the vault is synced)
        for f in sorted(os.listdir(OBSIDIAN_SNIPPETS)):
            write(os.path.join(cfg, "snippets", f), open(os.path.join(OBSIDIAN_SNIPPETS, f)).read())
        path = os.path.join(cfg, "appearance.json")
        app = json.load(open(path)) if os.path.exists(path) else {}
        snippets = app.setdefault("enabledCssSnippets", [])
        for name in ["desktop-theme"] + [f[:-4] for f in sorted(os.listdir(OBSIDIAN_SNIPPETS))]:
            if name not in snippets:
                snippets.append(name)
        app["theme"] = "moonstone" if t.get("mode") == "light" else "obsidian"
        write(path, json.dumps(app, indent=2, ensure_ascii=False) + "\n")


def rmpc(t):
    """rmpc's default theme with the selection colours from the palette. Its defaults use
    ANSI black-on-blue for the current item, unreadable when "black" is not dark (light themes)."""
    out = capture("rmpc", "theme")
    if not out:
        return                                            # rmpc not installed
    sel = f'(fg: "{t["accent_fg"]}", bg: "{t["accent"]}", modifiers: "Bold")'
    for old, new in [
        ('highlighted_item_style: (fg: "blue", modifiers: "Bold")',
         f'highlighted_item_style: (fg: "{t["border"]}", modifiers: "Bold")'),
        ('current_item_style: (fg: "black", bg: "blue", modifiers: "Bold")', f"current_item_style: {sel}"),
        ('active_style: (fg: "black", bg: "blue", modifiers: "Bold")', f"active_style: {sel}"),
        ('borders_style: (fg: "blue")', f'borders_style: (fg: "{t["dim"]}")'),
        ('highlight_border_style: (fg: "blue")', f'highlight_border_style: (fg: "{t["border"]}")'),
        ('elapsed_style: (fg: "blue")', f'elapsed_style: (fg: "{t["accent"]}")'),
        ('thumb_style: (fg: "blue")', f'thumb_style: (fg: "{t["accent"]}")'),
        ('style: (fg: "black", bg: "blue")', f'style: (fg: "{t["accent_fg"]}", bg: "{t["accent"]}")'),
        ('style: (fg: "black", bg: "green")', f'style: (fg: "{t["accent_fg"]}", bg: "{t["ok"]}")'),
        ('bg: "black"', f'bg: "{t["bg_hl"]}"'),
    ]:
        out = out.replace(old, new)
    write(f"{HOME}/.config/rmpc/themes/desktop.ron", f"// generated by `theme` from {t['name']}; do not edit\n" + out)
    cfg = f"{HOME}/.config/rmpc/config.ron"
    if os.path.exists(cfg):
        s = open(cfg).read()
        if "theme:" not in s:
            write(cfg, s.replace("(\n", '(\n    theme: Some("desktop"),\n', 1))


def emacs(t):
    write(f"{STATE}/emacs-theme", t["emacs_theme"] + "\n")
    # keep `user': it holds custom-set-faces from doom/config.el
    run("emacsclient", "--eval", f"(progn (mapc #'disable-theme (remq 'user custom-enabled-themes))"
        f" (load-theme '{t['emacs_theme']} t))")


def cursor(t):
    if not os.path.isdir(f"{HOME}/.icons/{t['cursor']}"):
        dest = f"{HOME}/.local/share/icons/{t['cursor']}"
        run("python3", CURSOR_GEN, dest, t["fg"], t["bg"], t["cursor"])
        os.symlink(dest, f"{HOME}/.icons/{t['cursor']}")
    write(f"{HOME}/.icons/default/index.theme", f"[Icon Theme]\nInherits={t['cursor']}\n")
    gtk = f"{HOME}/.config/gtk-3.0/settings.ini"
    if os.path.exists(gtk):
        s = re.sub(r"gtk-cursor-theme-name=.*", f"gtk-cursor-theme-name={t['cursor']}", open(gtk).read())
        write(gtk, s)


def wallpaper(t):
    out = capture("xrandr", "--listactivemonitors")
    imgs = []                                  # feh gives the images to the monitors in this (xrandr) order
    for m in re.finditer(r"^\s*\d+: \S+ (\d+)/\d+x\d+/\d+\S*\s+(\S+)$", out, re.M):
        imgs.append(wallpaper_file(t["wallpaper_3440"] if int(m.group(1)) >= 3000 else t["wallpaper_2560"]))
    if imgs and all(imgs):
        run("feh", "--no-fehbg", "--bg-fill", *imgs)


def wallpaper_file(name):
    """Local path of a wallpaper: a file name from the assets repo, downloaded into WALLPAPERS on first use."""
    path = os.path.join(WALLPAPERS, name)
    if not os.path.exists(path):
        import urllib.request
        try:
            os.makedirs(WALLPAPERS, exist_ok=True)
            with urllib.request.urlopen(f"{WALLPAPER_URL}/{name}", timeout=30) as r, open(path + ".part", "wb") as f:
                f.write(r.read())
            os.replace(path + ".part", path)
        except OSError as e:
            print(f"theme: cannot download wallpaper {name}: {e}", file=sys.stderr)
            return None
    return path


