{
    // macOS copy of settings.json (Linux): same fonts, sizes for a Retina screen (no UI zoom;
    // 16 = IBM VGA's native size, crisp at 2x). `theme` rewrites workbench.colorTheme in both.
    "editor.fontFamily": "'PxPlus IBM VGA 8x16', 'Cubic 11', monospace",
    "editor.fontSize": 16,
    "editor.fontLigatures": false,
    "terminal.integrated.fontFamily": "'PxPlus IBM VGA 8x16', 'Cubic 11', monospace",
    "terminal.integrated.fontSize": 16,
    // colours: the current theme from `theme` (~/System/dotfiles/themes), local extension "Retro Themes"
    "workbench.colorTheme": "Miku Crowd",
    // key codes, not characters: shortcuts keep working with the Karabiner layout (keymap/mac)
    "keyboard.dispatch": "keyCode",
    "claudeCode.preferredLocation": "panel",
    "claudeCode.hideOnboarding": true,
    "hediet.vscode-drawio.resizeImages": null
}
