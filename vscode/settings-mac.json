{
    // macOS copy of settings.json (Linux): same fonts; UI zoomed 1.5x as on Linux
    // (window.zoomLevel 2.2239 = 1.2^2.2239), so 16 shows at 24 pt. `theme` rewrites workbench.colorTheme in both.
    "window.zoomLevel": 2.2239,
    "editor.fontFamily": "'Fizzy Bubbles Code', 'StarLovePencil', monospace",
    "editor.fontSize": 16,
    "editor.fontLigatures": false,
    "terminal.integrated.fontFamily": "'Fizzy Bubbles Code', 'StarLovePencil', monospace",
    "terminal.integrated.fontSize": 16,
    // colours: the current theme from `theme` (~/System/dotfiles/themes), local extension "Retro Themes"
    "workbench.colorTheme": "Neon Canal",
    // key codes, not characters: shortcuts keep working with the Karabiner layout (keymap/mac)
    "keyboard.dispatch": "keyCode",
    "claudeCode.preferredLocation": "panel",
    "claudeCode.hideOnboarding": true,
    "hediet.vscode-drawio.resizeImages": null
}
